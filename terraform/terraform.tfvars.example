# Copy this file to terraform.tfvars and fill in values
# DO NOT commit terraform.tfvars with real values

subscription_id      = "your-azure-subscription-id"
project_name         = "dangdai"
resource_group_name  = "dangdai-rg"
location             = "eastus"
image_tag            = "latest"
supabase_url         = "https://xxx.supabase.co"
supabase_service_key = "eyJ..."
supabase_jwt_secret  = "your-supabase-jwt-secret"
openai_api_key       = "sk-proj-..."  # OpenAI API key (primary LLM provider as of Story 4.17)
openai_model         = "gpt-5"        # Optional: defaults to gpt-5
llm_api_key          = ""             # Legacy/deprecated — leave empty
langsmith_api_key    = ""             # Optional: LangSmith API key for observability
