# Supabase Configuration
# Get these values from https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
# Service Role Key - KEEP SECRET, never expose to clients. This key bypasses RLS.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Supported providers: openai (default), azure_openai, anthropic
LLM_PROVIDER=openai

# --- OpenAI (default provider) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
LLM_MAX_TOKENS=4096

# Generation / request tuning
GENERATION_TIMEOUT_SECONDS=25
MAX_RETRIES=0

# --- Azure OpenAI (rollback / alternative provider) ---
# To fall back to Azure OpenAI, set LLM_PROVIDER=azure_openai and configure:
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Anthropic (alternative provider) ---
# To use Anthropic instead, set LLM_PROVIDER=anthropic and configure:
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override the default model for the selected provider
# LLM_MODEL=gpt-5

# --- LLM Parameters (optional) ---
# These use sensible defaults if not set
# LLM_TEMPERATURE=0.7

# LangSmith (Optional - for observability)
LANGSMITH_API_KEY=ls-...
LANGSMITH_PROJECT=dangdai-api

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
