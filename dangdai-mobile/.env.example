# Supabase Configuration
# Get these values from https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api

# Supabase Project URL
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co

# Supabase Anon (Public) Key - safe to expose in client apps
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Python Backend API
# For local development:
# EXPO_PUBLIC_API_URL=http://localhost:8000
# For production (Azure Container Apps):
EXPO_PUBLIC_API_URL=https://dangdai-api.yellowcoast-f84a7cfb.eastus.azurecontainerapps.io

# ============================================================
# Playwright / E2E test variables (not used by the app itself)
# ============================================================

# Target environment: local | staging | production
TEST_ENV=local

# Override dev-server port (default: 3838)
PORT=3838

# Backend API base URL used by api-helpers in tests
API_URL=http://localhost:8000

# Test user credentials for auth-fixture (Supabase password auth)
TEST_USER_EMAIL=test@test.com
TEST_USER_PASSWORD=password
